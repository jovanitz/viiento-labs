{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "lab-dashboard",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd apps/lab/dashboard && npx vite --port 4201 --host 127.0.0.1"
      ],
      "port": 4201,
      "autoPort": false
    },
    {
      "name": "lab-client",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd apps/lab/client && npx vite --port 4202 --host 127.0.0.1"
      ],
      "port": 4202,
      "autoPort": false
    },
    {
      "name": "bison-dashboard",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd apps/bison/dashboard && VITE_DEV_AUTH=1 npx vite --port 4203 --host 127.0.0.1"
      ],
      "port": 4203,
      "autoPort": false
    },
    {
      "name": "bison-client",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd apps/bison/client && VITE_DEV_AUTH=1 npx vite --port 4204 --host 127.0.0.1"
      ],
      "port": 4204,
      "autoPort": false
    },
    {
      "name": "bison-api",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "npx tsx watch apps/bison/api/src/main.ts"
      ],
      "port": 3333,
      "autoPort": false
    },
    {
      "name": "bison-api-devstub",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "SUPABASE_DB_URL= SUPABASE_URL= SUPABASE_JWT_SECRET= npx tsx watch apps/bison/api/src/main.ts"
      ],
      "port": 3333,
      "autoPort": false
    },
    {
      "name": "storybook",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "npx storybook dev -p 6006 -c libs/ui/.storybook --no-open --host 127.0.0.1"
      ],
      "port": 6006,
      "autoPort": false
    },
    {
      "name": "bison-api-real",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd apps/bison/api && npx tsx watch src/main.ts"
      ],
      "port": 3333,
      "autoPort": false
    },
    {
      "name": "bison-client-real",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd apps/bison/client && npx vite --port 4204 --host 127.0.0.1"
      ],
      "port": 4204,
      "autoPort": false
    }
  ]
}
